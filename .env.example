# Qdrant Cloud (free tier: 1GB RAM / 4GB disk)
QDRANT_URL=https://your-cluster-id.region.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# Embeddings run locally (sentence-transformers) — no account, no API key,
# no quota. First run downloads and caches the model weights (~130MB).
QDRANT_COLLECTION=design_system_index
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
