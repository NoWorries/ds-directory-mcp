{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ds-directory-mcp/design-system.schema.json",
  "title": "Design Systems Directory export",
  "description": "Shape of systems.json (every indexed system) and each systems/<slug>.json (one system, same record). Archived/dead systems are excluded — see systems.yaml's own 'archived' field if you need those too. Generated by generate_data_export.py; never hand-edited.",
  "type": "object",
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this file was built."
    },
    "data_as_of": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "The OLDEST last_checked among all included records — the honest staleness bound for the whole file, not just when it was generated."
    },
    "total_systems": {
      "type": "integer"
    },
    "systems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system"
      }
    }
  },
  "required": [
    "generated_at",
    "total_systems",
    "systems"
  ],
  "$defs": {
    "system": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "URL slug — also the systems/<id>.json / systems/<id>.html filename."
        },
        "organization": {
          "type": [
            "string",
            "null"
          ]
        },
        "design_system": {
          "type": "string"
        },
        "full_name": {
          "type": "string",
          "description": "\"Organization — Design system\", or just the name when they're the same."
        },
        "start_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "detail_url": {
          "type": "string",
          "description": "Root-relative path to this system's own HTML page."
        },
        "pages_indexed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "coverage_status": {
          "enum": [
            "full",
            "partial",
            "unknown"
          ]
        },
        "hit_max_pages": {
          "type": "boolean",
          "description": "True if the crawl stopped at its page cap with more real content still queued."
        },
        "likely_spa": {
          "type": "boolean",
          "description": "True if the crawler found no usable static HTML (a JS-rendered site it can't see through)."
        },
        "last_checked": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "last_modified": {
          "type": [
            "string",
            "null"
          ],
          "description": "The start URL's own Last-Modified header, if the server sent one."
        },
        "sitemap_last_modified": {
          "type": [
            "string",
            "null"
          ],
          "description": "Max <lastmod> across the site's sitemap, if it has one — a stronger freshness signal than last_modified alone."
        },
        "resources": {
          "type": "object",
          "description": "Discovered links by category (github, npm, storybook, figma, mcp, skills, agent_instructions, copilot_instructions, cursor_rules, registry, icons, markdown_docs) — each value is a list of URLs, since a system can have more than one of the same type.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "unverified_resources": {
          "type": "object",
          "description": "Subset of resources.github/npm whose name doesn't obviously relate to this system (see resources.py's looks_related()) — flagged for a human to double-check, not necessarily wrong."
        },
        "content_signals": {
          "type": "object",
          "description": "Best-effort signals detected from crawled page text — see content_signals.py.",
          "properties": {
            "accessibility_conformance": {
              "type": "string"
            },
            "tokens_format": {
              "type": "string"
            },
            "frameworks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "dark_mode": {
              "type": "boolean"
            },
            "multi_brand": {
              "type": "boolean"
            },
            "governance_model": {
              "type": "boolean"
            },
            "deprecation_policy": {
              "type": "boolean"
            },
            "cli_scaffolding": {
              "type": "boolean"
            },
            "codemods": {
              "type": "boolean"
            },
            "figma_code_connect": {
              "type": "boolean"
            },
            "prompt_library": {
              "type": "boolean"
            }
          }
        },
        "github_meta": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "license": {
              "type": [
                "string",
                "null"
              ]
            },
            "stars": {
              "type": [
                "integer",
                "null"
              ]
            },
            "last_pushed": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "npm_meta": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "latest_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "weekly_downloads": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "indexed_pages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "url",
              "title"
            ]
          }
        }
      },
      "required": [
        "id",
        "design_system",
        "full_name",
        "start_urls",
        "detail_url"
      ]
    }
  }
}